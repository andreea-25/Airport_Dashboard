# PostgreSQL: `npm run local` (embedded, no Docker) or `docker compose up -d` — same URL works for both
DATABASE_URL="postgresql://airport:airport@localhost:5432/airport?schema=public"

# Ollama (local GPU)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_NUM_CTX=8192

# Session cookie signing secret (any long random string)
SESSION_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Demo account password used by the seed for all demo accounts
SEED_DEMO_PASSWORD="Demo2026!"

# Optional SMTP (stretch goal, e.g. Mailpit)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
