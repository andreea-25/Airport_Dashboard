# PostgreSQL: `npm run local` (embedded, no Docker) or `docker compose up -d` — same URL works for both (port 5433, so it does not clash with a PostgreSQL already installed on 5432)
DATABASE_URL="postgresql://airport:airport@localhost:5433/airport?schema=public"

# AI provider: "ollama" (local, default) or "gemini" (Google AI Studio key, free tier has rate limits)
AI_PROVIDER="ollama"
# Key from https://aistudio.google.com/apikey (never commit it)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
# If Gemini fails (no internet, quota) try local Ollama: "ollama" (default) or "none"
AI_FALLBACK="ollama"

# Ollama (local GPU)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_NUM_CTX=8192

# Set to "true" only when the app is served over HTTPS
COOKIE_SECURE="false"

# Session cookie signing secret (any long random string)
SESSION_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Demo account password used by the seed for all demo accounts
SEED_DEMO_PASSWORD="Demo2026!"

# Optional SMTP (stretch goal, e.g. Mailpit)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
