// Cazuri de test scrise de mână: formulări diferite de cele din generator, ca să vedem dacă modelul generalizează.
// {{today}}, {{tomorrow}}, {{saturday}}, {{sunday}}, {{nextMonday}}, {{nextSunday}} se înlocuiesc cu datele reale la rulare.
{"id": "m1", "category": "ture", "mode": "EMPLOYEE", "userEmail": "angajat.securitate@aeroport.demo", "prompt": "salut, am de lucru sambata asta?", "expect": {"tools": ["get_my_shifts"], "args": [{"tool": "get_my_shifts", "dateRangeCovers": {"from": "{{saturday}}", "to": "{{saturday}}"}}], "forbidTools": ["create_request"]}}
{"id": "m2", "category": "ture", "mode": "EMPLOYEE", "userEmail": "angajat.handling@aeroport.demo", "prompt": "La ce oră trebuie să fiu la aeroport mâine dimineață?", "expect": {"tools": ["get_my_shifts"], "args": [{"tool": "get_my_shifts", "dateRangeCovers": {"from": "{{tomorrow}}", "to": "{{tomorrow}}"}}]}}
