{"id": "m4", "category": "ture", "mode": "EMPLOYEE", "userEmail": "angajat.prm@aeroport.demo", "prompt": "Am vreo tură de noapte în următoarele două săptămâni?", "expect": {"tools": ["get_my_shifts"], "forbidTools": ["create_request"]}}
