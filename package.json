{
  "name": "airport-workforce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "local": "node scripts/local.mjs",
    "local:prod": "node scripts/local.mjs --prod",
    "local:db": "node scripts/local.mjs --db-only",
    "local:reset": "node scripts/local.mjs --reset",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "mock:ollama": "node scripts/mock-ollama.mjs",
    "ai:generate": "tsx scripts/ai-data/generate.ts",
    "ai:eval": "tsx scripts/ai-data/eval.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.2",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "jose": "6.1.0",
    "next": "15.5.4",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "3.2.1",
    "server-only": "0.0.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "dotenv": "17.2.2",
    "embedded-postgres": "17.9.0-beta.17",
    "postcss": "8.5.6",
    "prisma": "7.10.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
